{
  "name": "opl-whatsapp-server",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "type": "module",
  "scripts": {
    "start": "bun run biome check && bun _build && node --env-file=.env ./dist/server.js",
    "_build": "rm -rf dist && bun ./build.ts",
    "check": "bun install && bun run biome check && tsc --noEmit && bun _build",
    "lint": "bun run biome check --write",
    "fix": "bun lint",
    "updates": "bun update --latest",
    "try": "bun _build test && node --env-file=.env ./dist/test.js",
    "preview": "bun preview-branch.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.21",
    "cookie": "^1.1.1",
    "mongoose": "^9.0.1",
    "nanoid": "^5.1.6",
    "openai": "^6.10.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.1.13",
    "pm2": "7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@hapi/boom": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/cookie": "^1.0.0",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@whiskeysockets/baileys",
    "protobufjs",
    "sharp"
  ]
}
